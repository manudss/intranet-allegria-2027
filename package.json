{
  "name": "@mej-allegria/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "serve:web": "nx serve web",
    "serve:api": "nx serve api",
    "serve": "nx run-many --target=serve --projects=web,api",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "format": "nx format:write --all",
    "typeorm": "typeorm-ts-node-commonjs -d apps/api/src/database/typeorm.config.ts",
    "migration:generate": "npm run typeorm -- migration:generate apps/api/src/database/migrations/InitSchema",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed:api": "tsx apps/api/src/database/seeds/seed.ts --profile=medium",
    "seed:api:small": "tsx apps/api/src/database/seeds/seed.ts --profile=small",
    "seed:api:large": "tsx apps/api/src/database/seeds/seed.ts --profile=large"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~22.0.4",
    "@angular-devkit/schematics": "~22.0.4",
    "@angular/build": "~22.0.4",
