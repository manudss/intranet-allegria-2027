# Backend runtime
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200
DATABASE_URL=
DATABASE_URL_DIRECT=
DB_SSL=true

# Local PostgreSQL fallback
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mej_allegria
DB_USER=mej_user
DB_PASSWORD=mej_password

# Frontend public build-time config
WEB_API_URL=

# Family registration: configure only an authorized Alegria sender. No fallback to another project.
# smtp stays available outside RenderFree. resend uses HTTPS, no implicit generic key.
FAMILY_MAIL_PROVIDER=smtp
FAMILY_RESEND_API_KEY=
FAMILY_SMTP_HOST=
FAMILY_SMTP_PORT=587
FAMILY_SMTP_SECURE=false
FAMILY_SMTP_USER=
FAMILY_SMTP_PASSWORD=
FAMILY_MAIL_FROM=
# Health is OFF unless every prerequisite exists. See docs/inscriptions/espace-famille.md.
# Do not activate real health collection before legal/care/privacy/hosting qualification.
FAMILY_HEALTH_APPROVAL_REFERENCE=
FAMILY_HEALTH_ENCRYPTION_KEY=
FAMILY_HEALTH_DECLARATION_VERSION=
FAMILY_HEALTH_DECLARATION_TEXT=
